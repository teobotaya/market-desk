# Market Desk · configuración opcional
# Copiá este archivo como .env (en la misma carpeta) y completá solo lo que quieras.
# Ninguna clave es obligatoria: sin claves funciona todo salvo el botón "Analizar con IA".
# El .env está en el .gitignore: nunca se sube al repositorio.

# ------------------------------------------------------------- IA gratuita
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq, muy rápido: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter, usa solo modelos gratuitos (":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral, plan Experiment: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Ollama corre modelos en tu propia máquina (https://ollama.com). Definí el modelo instalado:
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_URL=http://127.0.0.1:11434

# --------------------------------------------------------------- IA de pago
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Proveedor por defecto si hay varias claves: gemini, groq, openrouter, cerebras, mistral, ollama, anthropic u openai
# IA_PROVEEDOR=groq
# Para fijar un modelo puntual (si no, se elige solo): GEMINI_MODEL, GROQ_MODEL, OPENROUTER_MODEL, CEREBRAS_MODEL, MISTRAL_MODEL, ANTHROPIC_MODEL, OPENAI_MODEL
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------- datos opcionales
# Finnhub, plan gratuito de 60 consultas por minuto: https://finnhub.io/register
# FINNHUB_API_KEY=

# ------------------------------------------------------------------ servidor
# PORT=5173
# Para abrirlo desde otro dispositivo de tu red usá 0.0.0.0 (cualquiera en esa red podría usar tu clave de IA)
# HOST=127.0.0.1
# La SEC exige identificarse con un contacto
# SEC_UA=market-desk/2.0 (tu-mail@ejemplo.com)
